<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="import_company_rule" model="ir.rule">
    <field name="name">Catalog imports: selected companies only</field>
    <field name="model_id" ref="model_ap_catalog_import"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="overview_company_rule" model="ir.rule">
    <field name="name">Parts stock: selected companies only</field>
    <field name="model_id" ref="model_ap_stock_overview"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
