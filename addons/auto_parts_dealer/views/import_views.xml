<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="catalog_import_list" model="ir.ui.view"><field name="name">ap.catalog.import.list</field><field name="model">ap.catalog.import</field><field name="arch" type="xml"><list decoration-success="state=='applied'"><field name="name"/><field name="company_id"/><field name="row_count"/><field name="state" widget="badge"/><field name="create_uid"/><field name="create_date"/><field name="applied_by"/><field name="applied_at"/></list></field></record>
  <record id="catalog_import_form" model="ir.ui.view">
    <field name="name">ap.catalog.import.form</field><field name="model">ap.catalog.import</field>
    <field name="arch" type="xml"><form string="Reviewed Catalog Import">
      <header><button name="action_validate" type="object" string="Validate / Revalidate" class="btn-primary" invisible="state=='applied'"/><button name="action_apply" type="object" string="Apply Reviewed Import" class="btn-primary" invisible="state!='validated'" confirm="Apply this reviewed catalog batch? This updates product records. No stock quantities or accounting entries are imported."/><field name="state" widget="statusbar"/></header>
      <sheet><div class="oe_title"><h1><field name="name" readonly="state=='applied'"/></h1></div>
        <div class="alert alert-info" role="alert">Validate → review the complete plan → apply. Upload the exact UTF-8 template, maximum 1,000 rows / 2 MB. Existing cost and unit/category changes require native Odoo review.</div>
        <group><group><field name="company_id" readonly="state=='applied'"/><field name="file" filename="filename" readonly="state=='applied'"/><field name="filename" invisible="1"/><field name="row_count"/></group><group><field name="digest"/><field name="applied_by"/><field name="applied_at"/></group></group>
        <notebook><page string="Review Plan"><field name="preview" nolabel="1"/></page><page string="Applied Products" invisible="state!='applied'"><field name="product_ids" readonly="1"/></page></notebook>
      </sheet></form></field>
  </record>
  <record id="action_catalog_import" model="ir.actions.act_window"><field name="name">Reviewed Catalog Imports</field><field name="res_model">ap.catalog.import</field><field name="view_mode">list,form</field></record>
</odoo>
