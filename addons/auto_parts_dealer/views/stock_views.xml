<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="parts_stock_list" model="ir.ui.view"><field name="name">ap.stock.overview.list</field><field name="model">ap.stock.overview</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="available &lt; 0"><field name="product_id"/><field name="location_id"/><field name="brand"/><field name="category_id"/><field name="quantity" sum="On hand"/><field name="reserved" sum="Reserved"/><field name="available" sum="Unreserved"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="parts_stock_pivot" model="ir.ui.view"><field name="name">ap.stock.overview.pivot</field><field name="model">ap.stock.overview</field><field name="arch" type="xml"><pivot string="Parts by Location" disable_linking="1"><field name="location_id" type="row"/><field name="product_id" type="row"/><field name="quantity" type="measure"/><field name="reserved" type="measure"/><field name="available" type="measure"/></pivot></field></record>
  <record id="parts_stock_graph" model="ir.ui.view"><field name="name">ap.stock.overview.graph</field><field name="model">ap.stock.overview</field><field name="arch" type="xml"><graph string="Internal Location Stock" type="bar"><field name="location_id"/><field name="quantity" type="measure"/></graph></field></record>
  <record id="parts_stock_search" model="ir.ui.view"><field name="name">ap.stock.overview.search</field><field name="model">ap.stock.overview</field><field name="arch" type="xml"><search><field name="product_id"/><field name="location_id"/><field name="brand"/><filter name="negative" string="Negative unreserved" domain="[('available','&lt;',0)]"/><filter name="reserved" string="With reservations" domain="[('reserved','&gt;',0)]"/><group><filter name="by_location" string="Location" context="{'group_by':'location_id'}"/><filter name="by_brand" string="Brand" context="{'group_by':'brand'}"/><filter name="by_product" string="Product" context="{'group_by':'product_id'}"/></group></search></field></record>
  <record id="action_parts_stock" model="ir.actions.act_window"><field name="name">Location Stock Overview</field><field name="res_model">ap.stock.overview</field><field name="view_mode">list,pivot,graph</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Stock appears after a received delivery or reviewed opening count.</p><p>Company-owned quantities in internal locations only. Units across different products must not be interpreted as a valuation or sales forecast.</p></field></record>
</odoo>
